# Copia este archivo a .env y ajústalo (install.sh lo hace por ti la primera vez).

# Carpeta donde se guardan TODOS los datos (la base de datos SQLite con tus QR).
# Ejemplo en una Raspberry Pi con disco externo: DATA_DIR=/mnt/disco/qr-panel
DATA_DIR=./data

# Puerto en el que se abre la web (http://IP-DE-TU-SERVIDOR:8091)
PORT=8091

# Zona horaria (lista: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Madrid

# UID/GID del usuario dueño de los archivos (mira el tuyo con: id -u ; id -g)
PUID=1000
PGID=1000

# Dirección pública con la que se llega a QRPanel desde internet, por ejemplo
# https://qr.midominio.com. Es la que llevan dentro los QR dinámicos: ponla ANTES de
# imprimirlos. Si la dejas vacía se usa la de la web (y se puede cambiar en Ajustes).
PUBLIC_URL=

# Opcional: crea este administrador al arrancar si no existe.
# Si lo dejas vacío, el primer usuario que se registre será el administrador.
# Usa una contraseña larga y no subas nunca el archivo .env a GitHub.
ADMIN_USER=
ADMIN_PASSWORD=

# 1 = cualquiera puede pedir cuenta (el admin la aprueba); 0 = solo el admin crea cuentas
ALLOW_REGISTER=1
